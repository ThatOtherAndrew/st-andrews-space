---
import { Image } from 'astro:assets';
---

<a href="/">
  <Image src="/favicon.png" alt="Site logo" width=50 height=50 loading="eager" />
  <h2>St Andrews Space</h2>
</a>

<style>
  a {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  img {
    display: block;
    position: relative;
    bottom: 8px;
    margin-right: 20px;
  }

  h2 {
    margin: 0;
  }

  @media screen and (max-width: 800px) {
    h2 {
      display: none;
    }
  }

  @media screen and (max-width: 520px) {
    a {
      display: none;
    }
  }
</style>
